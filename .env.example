# Скопировать в .env и поменять пароли. Все переменные необязательные: без .env работают значения по умолчанию.

POSTGRES_USER=tenderhack
POSTGRES_PASSWORD=tenderhack
POSTGRES_DB=tenderhack
RABBITMQ_USER=tenderhack
RABBITMQ_PASSWORD=tenderhack

# Порты на хосте
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
OLLAMA_PORT=11434
API_PORT=8000
WEB_PORT=8080

# Модели. Внешние облачные API по правилам TenderHack запрещены — только наш Ollama или наш GPU-сервер.
# Тяжёлые модели организатор штрафует: начинать с лёгких и мерить (uv run python -m app.tools.llm_smoke).
#
# Вариант 1 — Ollama на этой машине (из контейнеров он виден как host.docker.internal):
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
#   Ollama в контейнере (docker compose --profile llm): LLM_BASE_URL=http://ollama:11434
# Вариант 2 — наш GPU-сервер с OpenAI-совместимым API (vLLM, llama.cpp server, Ollama /v1):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://<адрес-сервера>:8000/v1
#   LLM_API_KEY=<токен сервера, если включён>
# Вариант 3 — Ollama Cloud, ТОЛЬКО для разработки до хакатона (на хакатоне облачные API запрещены,
# данные организаторов туда не отправлять). Эмбеддингов в облаке нет: /api/embed отвечает 401.
#   LLM_BASE_URL=https://ollama.com
#   LLM_API_KEY=<ключ с ollama.com/settings/keys>
#   LLM_CHAT_MODEL=gpt-oss:120b   # замер 01.10: сложное извлечение 8/8, выбор КТРУ верно, 1–3 с
#   LLM_THINK=low                 # gpt-oss не выключает рассуждения, low делает их короче
# Бесплатный тариф: флагманы (kimi, deepseek, glm, minimax, mistral) отвечают 402.
LLM_API_KEY=
LLM_CHAT_MODEL=qwen3:4b
# Рассуждения: false — выключить (qwen3 с ними в разы медленнее); low / medium / high — для моделей,
# которые не выключают их совсем (gpt-oss); модели без режима рассуждений получают запрос повторно без него.
LLM_THINK=false
LLM_REQUIRED=false

# Эмбеддинги: пусто — там же, где чат. Можно отдельно (например, эмбеддинги локально, чат на сервере).
EMBED_PROVIDER=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=bge-m3

# Справочник позиций: файлы через запятую (.json или .csv). Пусто — демо-справочник из репозитория
# (backend/app/catalog/demo/demo.json). Справочник организаторов: data/<файл> (в docker это /app/data/<файл>).
CATALOG_PATHS=
# Порог «товар вне справочника» (0..1) — калибруется: python -m app.tools.evaluate
SEARCH_MIN_SCORE=0.2
# Куда evaluate пишет метрики; их отдаёт GET /api/v1/metrics
METRICS_PATH=data/metrics/latest.json
# Куда portal_report пишет отчёт по живым карточкам портала; его отдаёт GET /api/v1/metrics/portal
PORTAL_REPORT_PATH=data/metrics/portal.json
# Кэш ответов модели в Redis, секунды (0 — выключить, например при сравнении моделей)
LLM_CACHE_TTL_S=86400

LOG_LEVEL=INFO
