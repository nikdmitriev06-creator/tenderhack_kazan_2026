<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="https://tenderhack.ru/kazan">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="pool" name="Создание СТЕ на Портале поставщиков" processRef="process" />
  </bpmn:collaboration>
  <bpmn:process id="process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane_supplier" name="Поставщик (портал)">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_module" name="Модуль автозаполнения">
        <bpmn:flowNodeRef>autofill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>unique</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>blocking</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_moderator" name="Модератор (портал)">
        <bpmn:flowNodeRef>moderate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Нужна новая СТЕ" />
    <bpmn:task id="enter" name="Ввести наименование и описание" />
    <bpmn:task id="autofill" name="Подобрать позицию КТРУ и заполнить характеристики" />
    <bpmn:exclusiveGateway id="unique" name="Код КТРУ однозначен?" />
    <bpmn:task id="answer" name="Ответить на уточняющий вопрос" />
    <bpmn:task id="review" name="Принять или поправить значения" />
    <bpmn:task id="check" name="Проверить карточку по правилам модерации" />
    <bpmn:exclusiveGateway id="blocking" name="Есть блокирующие замечания?" />
    <bpmn:task id="submit" name="Отправить на модерацию" />
    <bpmn:task id="moderate" name="Проверить заявку с замечаниями модуля" />
    <bpmn:exclusiveGateway id="decision" name="Принять заявку?" />
    <bpmn:task id="publish" name="Опубликовать СТЕ в каталоге" />
    <bpmn:endEvent id="end" name="СТЕ в каталоге" />
    <bpmn:sequenceFlow id="flow0" sourceRef="start" targetRef="enter" />
    <bpmn:sequenceFlow id="flow1" sourceRef="enter" targetRef="autofill" name="POST /autofill" />
    <bpmn:sequenceFlow id="flow2" sourceRef="autofill" targetRef="unique" />
    <bpmn:sequenceFlow id="flow3" sourceRef="unique" targetRef="answer" name="нет" />
    <bpmn:sequenceFlow id="flow4" sourceRef="answer" targetRef="unique" name="POST /answer" />
    <bpmn:sequenceFlow id="flow5" sourceRef="unique" targetRef="review" name="да" />
    <bpmn:sequenceFlow id="flow6" sourceRef="review" targetRef="check" name="POST /check" />
    <bpmn:sequenceFlow id="flow7" sourceRef="check" targetRef="blocking" />
    <bpmn:sequenceFlow id="flow8" sourceRef="blocking" targetRef="review" name="да" />
    <bpmn:sequenceFlow id="flow9" sourceRef="blocking" targetRef="submit" name="нет" />
    <bpmn:sequenceFlow id="flow10" sourceRef="submit" targetRef="moderate" />
    <bpmn:sequenceFlow id="flow11" sourceRef="moderate" targetRef="decision" />
    <bpmn:sequenceFlow id="flow12" sourceRef="decision" targetRef="publish" name="да" />
    <bpmn:sequenceFlow id="flow13" sourceRef="publish" targetRef="end" />
    <bpmn:sequenceFlow id="flow14" sourceRef="decision" targetRef="review" name="нет: вернуть с замечаниями" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collab">
      <bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1620" height="570" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_supplier_di" bpmnElement="lane_supplier" isHorizontal="true">
        <dc:Bounds x="40" y="0" width="1580" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_module_di" bpmnElement="lane_module" isHorizontal="true">
        <dc:Bounds x="40" y="190" width="1580" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_moderator_di" bpmnElement="lane_moderator" isHorizontal="true">
        <dc:Bounds x="40" y="380" width="1580" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="122" y="77" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enter_di" bpmnElement="enter">
        <dc:Bounds x="240" y="55" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="autofill_di" bpmnElement="autofill">
        <dc:Bounds x="240" y="245" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="unique_di" bpmnElement="unique" isMarkerVisible="true">
        <dc:Bounds x="455" y="260" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="answer_di" bpmnElement="answer">
        <dc:Bounds x="410" y="55" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review">
        <dc:Bounds x="580" y="55" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_di" bpmnElement="check">
        <dc:Bounds x="580" y="245" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="blocking_di" bpmnElement="blocking" isMarkerVisible="true">
        <dc:Bounds x="795" y="260" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="submit_di" bpmnElement="submit">
        <dc:Bounds x="920" y="55" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="moderate_di" bpmnElement="moderate">
        <dc:Bounds x="920" y="435" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision" isMarkerVisible="true">
        <dc:Bounds x="1135" y="450" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="publish_di" bpmnElement="publish">
        <dc:Bounds x="1260" y="435" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1482" y="457" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow0_di" bpmnElement="flow0">
        <di:waypoint x="158" y="95" />
        <di:waypoint x="240" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
        <di:waypoint x="310" y="135" />
        <di:waypoint x="310" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
        <di:waypoint x="380" y="285" />
        <di:waypoint x="455" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <di:waypoint x="466" y="260" />
        <di:waypoint x="466" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4">
        <di:waypoint x="494" y="135" />
        <di:waypoint x="494" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow5_di" bpmnElement="flow5">
        <di:waypoint x="505" y="285" />
        <di:waypoint x="540" y="285" />
        <di:waypoint x="540" y="160" />
        <di:waypoint x="620" y="160" />
        <di:waypoint x="620" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow6_di" bpmnElement="flow6">
        <di:waypoint x="650" y="135" />
        <di:waypoint x="650" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow7_di" bpmnElement="flow7">
        <di:waypoint x="720" y="285" />
        <di:waypoint x="795" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow8_di" bpmnElement="flow8">
        <di:waypoint x="820" y="260" />
        <di:waypoint x="820" y="212" />
        <di:waypoint x="690" y="212" />
        <di:waypoint x="690" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow9_di" bpmnElement="flow9">
        <di:waypoint x="845" y="285" />
        <di:waypoint x="960" y="285" />
        <di:waypoint x="960" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow10_di" bpmnElement="flow10">
        <di:waypoint x="1020" y="135" />
        <di:waypoint x="1020" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow11_di" bpmnElement="flow11">
        <di:waypoint x="1060" y="475" />
        <di:waypoint x="1135" y="475" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow12_di" bpmnElement="flow12">
        <di:waypoint x="1185" y="475" />
        <di:waypoint x="1260" y="475" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow13_di" bpmnElement="flow13">
        <di:waypoint x="1400" y="475" />
        <di:waypoint x="1482" y="475" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow14_di" bpmnElement="flow14">
        <di:waypoint x="1160" y="450" />
        <di:waypoint x="1160" y="22" />
        <di:waypoint x="650" y="22" />
        <di:waypoint x="650" y="55" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
